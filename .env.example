# Next.js Web Application Configuration
WEBAPP_PORT=3000

# Gitea Configuration
GITEA_HTTP_PORT=3001
GITEA_SSH_PORT=2222
GITEA_DOMAIN=localhost

# Gitea Database Configuration
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=changeme_secure_password

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Update the values above, especially GITEA_DB_PASSWORD
# 3. If using a custom domain, update GITEA_DOMAIN
